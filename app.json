{
  "expo": {
    "name": "ColorPicker",
    "slug": "colorpicker",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alu.colorpicker",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture colors from the real world.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.alu.colorpicker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0954f3d3-f1ee-4b53-a94d-82b2a356bb33"
      }
    },
    "owner": "alperunlu",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app uses the camera to capture colors from the real world.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app lets you choose a photo from your library to read its colors.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "./plugins/withPodsDeploymentTarget"
    ],
    "locales": {
      "es": "./locales/native/es.json",
      "pt": "./locales/native/pt.json",
      "fr": "./locales/native/fr.json",
      "de": "./locales/native/de.json",
      "ja": "./locales/native/ja.json",
      "zh-Hans": "./locales/native/zh-Hans.json",
      "ko": "./locales/native/ko.json",
      "vi": "./locales/native/vi.json",
      "tr": "./locales/native/tr.json"
    }
  }
}
